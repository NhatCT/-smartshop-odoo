{
  "name": "SmartShop Daily Reports (Low Stock 8:00 + Revenue 18:00)",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 8 * * *"
            }
          ]
        }
      },
      "id": "sched-lowstock",
      "name": "Schedule: 8:00 AM Low Stock Check",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [0, 200]
    },
    {
      "parameters": {
        "resource": "custom",
        "operation": "getAll",
        "customResource": "product.product",
        "filter": "=[[\"is_storable\",\"=\",true]]",
        "fields": "name, default_code, qty_available",
        "options": {
          "returnAll": true
        },
        "verify": "false"
      },
      "id": "odoo-lowstock",
      "name": "Odoo: San pham ton kho <= 5",
      "type": "n8n-nodes-base.odoo",
      "typeVersion": 2,
      "position": [240, 200],
      "credentials": {
        "odooApi": {
          "id": "REPLACE_WITH_YOUR_ODOO_CREDENTIAL_ID",
          "name": "Odoo Account"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "// Tong hop tat ca san pham storable -> loc va format cac san pham co qty_available <= 5\nconst items = $input.all();\nconst lowStockItems = [];\n\nfor (const entry of items) {\n  const item = entry.json || {};\n  const qty = item.qty_available !== undefined ? Number(item.qty_available) : 0;\n  const sku = item.default_code;\n  if (sku && qty <= 5) {\n    lowStockItems.push(item);\n  }\n}\n\nlet msg = '';\nif (lowStockItems.length === 0) {\n  msg = `✅ *BAO CAO TON KHO AN TOAN*\\n\\n`\n    + `_Tat ca san pham trong kho Odoo 19 đều o muc an toan (> 5 cai)._\\n`\n    + `• Tong san pham kiem tra: *${items.length} san pham*\\n`\n    + `• San pham canh bao (<= 5): *0 san pham*`;\n} else {\n  const lines = lowStockItems.map(item => {\n    const name = item.name || 'N/A';\n    const sku = item.default_code || 'N/A';\n    const qty = item.qty_available !== undefined ? item.qty_available : 0;\n    return `• *${name}*\\n  Ma SKU: \\`${sku}\\` | Ton kho: *${qty} cai*`;\n  }).join('\\n\\n');\n\n  msg = `⚠️ *CANH BAO TON KHO AN TOAN*\\n\\n`\n    + `Phat hien *${lowStockItems.length} san pham* duoi muc an toan (<= 5 cai):\\n\\n`\n    + `${lines}\\n\\n`\n    + `👉 Co the gao SmartShop AI Bot de tao Don mua hang (Draft PO) tren Odoo.`;\n}\n\nreturn [{ json: { chat_id: '6553206564', text: msg } }];"
      },
      "id": "code-lowstock",
      "name": "Code: Format Low Stock Alert",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [480, 200]
    },
    {
      "parameters": {
        "chatId": "={{ $json.chat_id }}",
        "text": "={{ $json.text }}",
        "additionalFields": {
          "parse_mode": "Markdown"
        }
      },
      "id": "tg-lowstock",
      "name": "Telegram: Gui Low Stock Alert",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.1,
      "position": [720, 200],
      "credentials": {
        "telegramApi": {
          "id": "REPLACE_WITH_YOUR_TELEGRAM_CREDENTIAL_ID",
          "name": "Telegram Bot"
        }
      }
    },
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 18 * * *"
            }
          ]
        }
      },
      "id": "sched-revenue",
      "name": "Schedule: 18:00 PM Daily Revenue Digest",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [0, 500]
    },
    {
      "parameters": {
        "resource": "custom",
        "operation": "getAll",
        "customResource": "sale.order",
        "filter": "={{ \"[[\\\"state\\\",\\\"in\\\",[\\\"sale\\\",\\\"done\\\"]],[\\\"date_order\\\",\\\">=\\\",\\\"\" + $now.startOf('day').toFormat('yyyy-MM-dd') + \"\\\"],[\\\"date_order\\\",\\\"<\\\",\\\"\" + $now.add(1, 'day').startOf('day').toFormat('yyyy-MM-dd') + \"\\\"]]\" }}",
        "fields": "name, amount_total, date_order",
        "options": {
          "returnAll": true
        },
        "verify": "false"
      },
      "id": "odoo-revenue",
      "name": "Odoo: Don ban hom nay (sale/done)",
      "type": "n8n-nodes-base.odoo",
      "typeVersion": 2,
      "position": [240, 500],
      "credentials": {
        "odooApi": {
          "id": "REPLACE_WITH_YOUR_ODOO_CREDENTIAL_ID",
          "name": "Odoo Account"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "// Tong hop tat ca don hom nay -> tinh tong doanh thu + so don\nconst items = $input.all();\n\nlet total = 0;\nlet count = items.length;\n\nfor (const it of items) {\n  total += Number(it.json.amount_total || 0);\n}\n\nconst dateStr = $now.toFormat('dd/MM/yyyy');\nconst totalStr = total.toLocaleString('vi-VN');\n\nconst msg = `📊 *BAO CAO DOANH THU KINH DOANH* 📊\\n`\n  + `_Ngay: ${dateStr}_\\n\\n`\n  + `• Tong so Don chot: *${count} Don hang*\\n`\n  + `• Tong doanh thu: *${totalStr} VND*\\n\\n`\n  + `• Tat ca don hang da duoc dong bo 100% sang Odoo 19 SaaS Enterprise.`;\n\nreturn [{ json: { chat_id: '6553206564', text: msg } }];"
      },
      "id": "code-revenue",
      "name": "Code: Tong hop doanh thu",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [480, 500]
    },
    {
      "parameters": {
        "chatId": "={{ $json.chat_id }}",
        "text": "={{ $json.text }}",
        "additionalFields": {
          "parse_mode": "Markdown"
        }
      },
      "id": "tg-revenue",
      "name": "Telegram: Gui Revenue Digest",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.1,
      "position": [720, 500],
      "credentials": {
        "telegramApi": {
          "id": "REPLACE_WITH_YOUR_TELEGRAM_CREDENTIAL_ID",
          "name": "Telegram Bot"
        }
      }
    }
  ],
  "connections": {
    "Schedule: 8:00 AM Low Stock Check": {
      "main": [
        [
          {
            "node": "Odoo: San pham ton kho <= 5",
            "type": "main",
            "index": 0
