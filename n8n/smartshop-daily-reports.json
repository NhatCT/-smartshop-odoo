{
  "name": "SmartShop Daily Reports (Low Stock 8:00 + Revenue 18:00)",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 8 * * *"
            }
          ]
        }
      },
      "id": "sched-lowstock",
      "name": "Schedule: 8:00 AM Low Stock Check",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [0, 200]
    },
    {
      "parameters": {
        "resource": "custom",
        "operation": "getAll",
        "customResource": "product.product",
        "filter": "=[[\"qty_available\",\"<=\",5]]",
        "fields": "name, default_code, qty_available",
        "options": {
          "returnAll": true
        }
      },
      "id": "odoo-lowstock",
      "name": "Odoo: San pham ton kho <= 5",
      "type": "n8n-nodes-base.odoo",
      "typeVersion": 1,
      "position": [240, 200],
      "credentials": {
        "odooApi": {
          "id": "REPLACE_WITH_YOUR_ODOO_CREDENTIAL_ID",
          "name": "Odoo Account"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "// Format tin nhan canh bao 1 san pham (node nay tu dong lap cho moi item)\nconst item = $input.first().json;\n\nconst name = item.name || 'N/A';\nconst sku = item.default_code || 'N/A';\nconst qty = item.qty_available !== undefined ? item.qty_available : 0;\n\nconst msg = `⚠️ *CANH BAO TON KHO AN TOAN*\\n\\n`\n  + `• San pham: ${name}\\n`\n  + `• Ma SKU: \\`${sku}\\`\\n`\n  + `• So luong ton: *${qty} cai* (Duoi muc an toan <= 5)\\n\\n`\n  + `👉 Bam nut tao Don mua hang (Draft PO) tren Odoo:`;\n\nreturn [{ json: { chat_id: '6553206564', text: msg } }];"
      },
      "id": "code-lowstock",
      "name": "Code: Format Low Stock Alert",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [480, 200]
    },
    {
      "parameters": {
        "chatId": "={{ $json.chat_id }}",
        "text": "={{ $json.text }}",
        "additionalFields": {
          "parse_mode": "Markdown"
        }
      },
      "id": "tg-lowstock",
      "name": "Telegram: Gui Low Stock Alert",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.1,
      "position": [720, 200],
      "credentials": {
        "telegramApi": {
          "id": "REPLACE_WITH_YOUR_TELEGRAM_CREDENTIAL_ID",
          "name": "Telegram Bot"
        }
      }
    },
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 18 * * *"
            }
          ]
        }
      },
      "id": "sched-revenue",
      "name": "Schedule: 18:00 PM Daily Revenue Digest",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [0, 500]
    },
    {
      "parameters": {
        "resource": "custom",
        "operation": "getAll",
        "customResource": "sale.order",
        "filter": "={{ \"[[\\\"state\\\",\\\"in\\\",[\\\"sale\\\",\\\"done\\\"]],[\\\"date_order\\\",\\\">=\\\",\\\"\" + $now.startOf('day').toFormat('yyyy-MM-dd') + \"\\\"],[\\\"date_order\\\",\\\"<\\\",\\\"\" + $now.add(1, 'day').startOf('day').toFormat('yyyy-MM-dd') + \"\\\"]]\" }}",
        "fields": "name, amount_total, date_order",
        "options": {
          "returnAll": true
        }
      },
      "id": "odoo-revenue",
      "name": "Odoo: Don ban hom nay (sale/done)",
      "type": "n8n-nodes-base.odoo",
      "typeVersion": 1,
      "position": [240, 500],
      "credentials": {
        "odooApi": {
          "id": "REPLACE_WITH_YOUR_ODOO_CREDENTIAL_ID",
          "name": "Odoo Account"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "// Tong hop tat ca don hom nay -> tinh tong doanh thu + so don\nconst items = $input.all();\n\nlet total = 0;\nlet count = items.length;\n\nfor (const it of items) {\n  total += Number(it.json.amount_total || 0);\n}\n\nconst dateStr = $now.toFormat('dd/MM/yyyy');\nconst totalStr = total.toLocaleString('vi-VN');\n\nconst msg = `📊 *BAO CAO DOANH THU KINH DOANH* 📊\\n`\n  + `_Ngay: ${dateStr}_\\n\\n`\n  + `• Tong so Don chot: *${count} Don hang*\\n`\n  + `• Tong doanh thu: *${totalStr} VND*\\n\\n`\n  + `• Tat ca don hang da duoc dong bo 100% sang Odoo 19 SaaS Enterprise.`;\n\nreturn [{ json: { chat_id: '6553206564', text: msg } }];"
      },
      "id": "code-revenue",
      "name": "Code: Tong hop doanh thu",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [480, 500]
    },
    {
      "parameters": {
        "chatId": "={{ $json.chat_id }}",
        "text": "={{ $json.text }}",
        "additionalFields": {
          "parse_mode": "Markdown"
        }
      },
      "id": "tg-revenue",
      "name": "Telegram: Gui Revenue Digest",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.1,
      "position": [720, 500],
      "credentials": {
        "telegramApi": {
          "id": "REPLACE_WITH_YOUR_TELEGRAM_CREDENTIAL_ID",
          "name": "Telegram Bot"
        }
      }
    }
  ],
  "connections": {
    "Schedule: 8:00 AM Low Stock Check": {
      "main": [
        [
          {
            "node": "Odoo: San pham ton kho <= 5",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Odoo: San pham ton kho <= 5": {
      "main": [
        [
          {
            "node": "Code: Format Low Stock Alert",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Code: Format Low Stock Alert": {
      "main": [
        [
          {
            "node": "Telegram: Gui Low Stock Alert",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Schedule: 18:00 PM Daily Revenue Digest": {
      "main": [
        [
          {
            "node": "Odoo: Don ban hom nay (sale/done)",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Odoo: Don ban hom nay (sale/done)": {
      "main": [
        [
          {
            "node": "Code: Tong hop doanh thu",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Code: Tong hop doanh thu": {
      "main": [
        [
          {
            "node": "Telegram: Gui Revenue Digest",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  },
  "pinData": {}
}