{
  "name": "SmartShop Odoo 19 Order Notification Workflow",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "odoo-order-webhook",
        "options": {}
      },
      "name": "Odoo Order Webhook Trigger",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [
        250,
        300
      ]
    },
    {
      "parameters": {
        "chatId": "-100123456789",
        "text": "=🎉 **CÓ ĐƠN HÀNG MỚI TỪ ODOO 19 SAAS!**\n\n📄 **Mã đơn hàng:** `{{ $json.body.name }}`\n👤 **Khách hàng:** {{ $json.body.partner_name }}\n💰 **Tổng số tiền:** {{ $json.body.amount_total }} VNĐ\n📊 **Trạng thái:** {{ $json.body.state }}\n\n⚡ *Thông báo tự động từ n8n Workflow Engine.*",
        "additionalFields": {
          "parse_mode": "Markdown"
        }
      },
      "name": "Send Admin Telegram Alert",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1,
      "position": [
        500,
        200
      ]
    },
    {
      "parameters": {
        "fromEmail": "sales@smartshop.com",
        "toEmail": "={{ $json.body.partner_email }}",
        "subject": "=Xác nhận Đơn hàng {{ $json.body.name }} - SmartShop Odoo",
        "html": "=<div style=\"font-family: Arial, sans-serif;\"><h2>Cảm ơn bạn đã đặt hàng tại SmartShop!</h2><p>Đơn hàng <b>{{ $json.body.name }}</b> trị giá <b>{{ $json.body.amount_total }} VNĐ</b> của bạn đã được khởi tạo thành công.</p><p>Vui lòng chuyển khoản VietQR để hoàn tất thanh toán.</p></div>"
      },
      "name": "Send Customer Confirmation Email",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 1,
      "position": [
        500,
        400
      ]
    }
  ],
  "connections": {
    "Odoo Order Webhook Trigger": {
      "main": [
        [
          {
            "node": "Send Admin Telegram Alert",
            "type": "main",
            "index": 0
          },
          {
            "node": "Send Customer Confirmation Email",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  }
}
