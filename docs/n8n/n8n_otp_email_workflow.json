{
  "name": "SmartShop OTP Email Sender",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "send-otp-email",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "otp-webhook-node",
      "name": "OTP Email Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [240, 300],
      "webhookId": "send-otp-email"
    },
    {
      "parameters": {
        "sendTo": "={{ $json.body.to_email }}",
        "subject": "=[SmartShop AI] Ma OTP xac thuc tai khoan Telegram cua ban",
        "emailType": "text",
        "message": "=Xin chao {{ $json.body.employee_name }},\n\nBan vua yeu cau xac thuc lien ket tai khoan Telegram voi he thong SmartShop AI Gateway.\n\nMa OTP cua ban la:\n\n>>> {{ $json.body.otp_code }} <<<\n\nMa nay co hieu luc trong 5 phut. Vui long quay lai Telegram va go:\n/verify {{ $json.body.otp_code }}\n\nNeu ban khong thuc hien yeu cau nay, vui long bo qua email nay.\n\n---\nHe thong SmartShop Enterprise AI Gateway\nBao mat 3 Lop Zero-Trust Security",
        "options": {}
      },
      "id": "otp-send-email-node",
      "name": "Send OTP Email",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2.1,
      "position": [480, 300],
      "credentials": {
        "gmailOAuth2": {
          "id": "gmail-credential-id",
          "name": "Gmail account"
        }
      }
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={ \"ok\": true, \"message\": \"OTP email sent to {{ $('OTP Email Webhook').item.json.body.to_email }}\" }",
        "options": {}
      },
      "id": "otp-respond-node",
      "name": "Respond Success",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [720, 300]
    }
  ],
  "connections": {
    "OTP Email Webhook": {
      "main": [
        [
          {
            "node": "Send OTP Email",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Send OTP Email": {
      "main": [
        [
          {
            "node": "Respond Success",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1"
  }
}
